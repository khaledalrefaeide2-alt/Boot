# =============================================================================
# منصة رصد وتحليل المنصات الإعلامية — متغيرات البيئة
#
# الطريقة الأسهل: لا تحرّر هذا الملف يدوياً، شغّل بدلاً منه:
#     ويندوز        .\setup.ps1
#     ماك / لينكس    bash setup.sh
#
# وإن أردت التحرير يدوياً: انسخ الملف إلى .env ثم غيّر القيم المعلّمة (مطلوب).
#
# قواعد يجب الالتزام بها عند التحرير اليدوي:
#   • كل سطر بالصيغة  KEY="value"  وعلامة = ضرورية ولا يجوز حذفها
#   • اكتب القيم بحروف لاتينية وأرقام — القيم العربية تُربك المحررات على ويندوز
#   • لا تضع الرمز # داخل القيمة
# =============================================================================

# -----------------------------------------------------------------------------
# 1) قاعدة البيانات
# -----------------------------------------------------------------------------
# عند التشغيل بـ Docker: هذه القيم تُنشئ القاعدة ويُبنى رابط الاتصال منها تلقائياً
POSTGRES_USER="monitor"
POSTGRES_DB="monitoring"

# (مطلوب) كلمة مرور قاعدة البيانات — حروف لاتينية وأرقام بلا مسافات
POSTGRES_PASSWORD="CHANGE_ME_db_password"

# عند التشغيل بدون Docker فقط — يتجاهله Docker لأنه يبني الرابط من القيم أعلاه
DATABASE_URL="postgresql://monitor:CHANGE_ME_db_password@localhost:5432/monitoring?schema=public"

# -----------------------------------------------------------------------------
# 2) Redis — الطوابير والتخزين المؤقت وتحديد المعدل
# -----------------------------------------------------------------------------
# عند التشغيل بدون Docker فقط (Docker يستخدم redis://redis:6379 تلقائياً)
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# 3) الأمان
# -----------------------------------------------------------------------------
# (مطلوب) مفتاح توقيع رموز الجلسات — 32 محرفاً على الأقل
# ولّده بالأمر:   openssl rand -base64 48
# تنبيه: تغييره لاحقاً يُبطل كل الجلسات وروابط استعادة كلمة المرور القائمة
SESSION_SECRET="CHANGE_ME_random_key_at_least_32_characters_long"

# عمر الجلسة بالأيام
SESSION_TTL_DAYS="7"

# عنوان التطبيق — يُستخدم للتحقق من مصدر الطلبات (حماية CSRF)
APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# 4) Apify — استخراج المنشورات
# -----------------------------------------------------------------------------
# رمز Apify — خادمي بحت لا يصل إلى المتصفح إطلاقاً
# احصل عليه من: https://console.apify.com/settings/integrations
# يمكن تركه فارغاً الآن: الموقع يعمل لكن الاستخراج لن يعمل حتى تضيفه
APIFY_TOKEN=""

APIFY_API_BASE="https://api.apify.com/v2"

# سقف صارم لعدد المنشورات في أي تشغيل مهما كانت إعدادات الحساب
APIFY_MAX_ITEMS_HARD_CAP="1000"

# مهلة انتظار انتهاء التشغيل بالثواني
APIFY_RUN_TIMEOUT_SECONDS="900"

# -----------------------------------------------------------------------------
# 5) حساب المالك الأول — يُنشأ مرة واحدة فقط عند أول تشغيل
# -----------------------------------------------------------------------------
# (مطلوب) بريدك — به ستدخل إلى النظام أول مرة
SEED_OWNER_EMAIL="owner@example.com"

# (مطلوب) اسمك — اكتبه بحروف لاتينية هنا، ويمكنك تغييره إلى العربية
# من داخل الموقع بعد الدخول: الملف الشخصي
SEED_OWNER_NAME="Platform Owner"

# (مطلوب) كلمة مرور دخولك — 10 محارف على الأقل وتحتوي على حروف ورقم
SEED_OWNER_PASSWORD="CHANGE_ME_login_password_1"

# -----------------------------------------------------------------------------
# 6) التشغيل
# -----------------------------------------------------------------------------
NODE_ENV="development"
