# =============================================================================
# منصة رصد وتحليل المنصات الإعلامية — متغيرات البيئة
#
# انسخ هذا الملف إلى .env  ثم املأ القيم المطلوبة:
#     cp .env.example .env
#
# القيم المعلّمة بـ (مطلوب) يجب تغييرها قبل أول تشغيل.
# لا تضع أي سر في الكود أو في الواجهة — كلها هنا فقط.
# =============================================================================

# -----------------------------------------------------------------------------
# 1) قاعدة البيانات
# -----------------------------------------------------------------------------
# عند التشغيل بـ Docker: هذه القيم تُنشئ القاعدة، ويبنى رابط الاتصال منها تلقائياً
POSTGRES_USER="monitor"
POSTGRES_DB="monitoring"
# (مطلوب) كلمة مرور قاعدة البيانات — اختر كلمة قوية
POSTGRES_PASSWORD="CHANGE_ME_كلمة_مرور_قاعدة_البيانات"

# عند التشغيل بدون Docker فقط: رابط الاتصال المباشر
# (يتجاهله Docker لأنه يبني الرابط من القيم أعلاه)
DATABASE_URL="postgresql://monitor:CHANGE_ME_كلمة_مرور_قاعدة_البيانات@localhost:5432/monitoring?schema=public"

# -----------------------------------------------------------------------------
# 2) Redis — الطوابير والتخزين المؤقت وتحديد المعدل
# -----------------------------------------------------------------------------
# عند التشغيل بدون Docker فقط (Docker يستخدم redis://redis:6379 تلقائياً)
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# 3) الأمان
# -----------------------------------------------------------------------------
# (مطلوب) مفتاح توقيع الجلسات — 32 محرفاً على الأقل
# ولّده بالأمر:  openssl rand -base64 48
SESSION_SECRET="CHANGE_ME_مفتاح_عشوائي_طويل_لا_يقل_عن_32_محرفا"

# عمر الجلسة بالأيام
SESSION_TTL_DAYS="7"

# عنوان التطبيق — يُستخدم للتحقق من مصدر الطلبات (حماية CSRF)
# غيّره إلى العنوان الفعلي إذا نشرته على خادم
APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# 4) Apify — استخراج المنشورات
# -----------------------------------------------------------------------------
# (مطلوب لتشغيل الاستخراج) رمز Apify — خادمي بحت، لا يصل إلى المتصفح إطلاقاً
# احصل عليه من: https://console.apify.com/settings/integrations
APIFY_TOKEN=""

APIFY_API_BASE="https://api.apify.com/v2"

# سقف صارم لعدد المنشورات في أي تشغيل مهما كانت إعدادات الحساب — حماية من الاستهلاك الزائد
APIFY_MAX_ITEMS_HARD_CAP="1000"

# مهلة انتظار انتهاء التشغيل بالثواني
APIFY_RUN_TIMEOUT_SECONDS="900"

# -----------------------------------------------------------------------------
# 5) حساب المالك الأول — يُنشأ مرة واحدة فقط عند أول تشغيل
# -----------------------------------------------------------------------------
# (مطلوب) بياناتك أنت — بها ستدخل إلى النظام أول مرة
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_NAME="اسمك الكامل"
# 10 محارف على الأقل وتحتوي على حروف ورقم
SEED_OWNER_PASSWORD="CHANGE_ME_كلمة_مرور_قوية_1"

# -----------------------------------------------------------------------------
# 6) التشغيل
# -----------------------------------------------------------------------------
NODE_ENV="development"
