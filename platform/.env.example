# =============================================================================
# منصة رصد وتحليل المنصات الإعلامية — متغيرات البيئة
# انسخ هذا الملف إلى .env واملأ القيم. لا تضع أي أسرار في الكود أو الواجهة.
# =============================================================================

# --- قاعدة البيانات ---
DATABASE_URL="postgresql://monitor:CHANGE_ME@localhost:5432/monitoring?schema=public"

# --- Redis (الطوابير والتخزين المؤقت وتحديد المعدل) ---
REDIS_URL="redis://localhost:6379"

# --- الأمان ---
# مفتاح توقيع الجلسات — 32 محرفاً على الأقل. ولّده بـ: openssl rand -base64 48
SESSION_SECRET="CHANGE_ME_عشوائي_طويل_جدا_لا_يقل_عن_32_محرفا"
# عمر الجلسة بالأيام
SESSION_TTL_DAYS="7"
# عنوان التطبيق (يُستخدم للتحقق من مصدر الطلبات — حماية CSRF)
APP_URL="http://localhost:3000"

# --- Apify ---
# رمز Apify — خادمي بحت، لا يصل إلى المتصفح إطلاقاً
APIFY_TOKEN=""
APIFY_API_BASE="https://api.apify.com/v2"
# أقصى عدد عناصر مسموح به لأي تشغيل — سقف فوترة صارم
APIFY_MAX_ITEMS_HARD_CAP="1000"
# مهلة انتظار انتهاء التشغيل بالثواني
APIFY_RUN_TIMEOUT_SECONDS="900"

# --- حساب المالك الأول (يُنشأ مرة واحدة عند تشغيل البذرة) ---
SEED_OWNER_EMAIL="owner@example.com"
SEED_OWNER_NAME="مالك المنصة"
SEED_OWNER_PASSWORD="CHANGE_ME_كلمة_مرور_قوية"

# --- التشغيل ---
NODE_ENV="development"
# تعطيل تشغيل العامل داخل عملية الويب (العامل يعمل في عملية مستقلة)
RUN_WORKER_IN_PROCESS="false"
