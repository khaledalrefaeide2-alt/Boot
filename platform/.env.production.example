# =============================================================================
# متغيرات البيئة للنشر الإنتاجي
#
#   انسخه على الخادم:  cp .env.production.example .env.production
#   ثم املأ القيم، ثم:  chmod 600 .env.production
#
# هذا الملف قالب بلا أسرار. الملف الحقيقي .env.production مستثنى من Git
# ولا يجوز رفعه إلى GitHub ولا نسخه في رسالة أو تذكرة.
# =============================================================================

# --- النطاق والشهادة -------------------------------------------------------
# النطاق بلا https:// وبلا شرطة مائلة. يجب أن يشير سجل A إلى IP الخادم
# قبل أول تشغيل، وإلا فشل طلب الشهادة.
APP_DOMAIN="monitoring.example.gov.sa"

# بريد يصلك عليه تنبيه من Let's Encrypt قبل انتهاء الشهادة إن تعطّل التجديد.
ACME_EMAIL="it@example.gov.sa"

# عناوين إضافية يُقبل منها الطلب، مفصولة بفواصل. اتركه فارغاً في الغالب:
# APP_URL يُشتق تلقائياً من APP_DOMAIN. يُستعمل فقط إن وصل الموقع من اسم ثانٍ.
APP_ALLOWED_ORIGINS=""

# --- قاعدة البيانات --------------------------------------------------------
# كلمة مرور طويلة عشوائية — ولّدها بـ:  openssl rand -base64 32
# لا تُكتب في DATABASE_URL هنا: ملف compose الإنتاجي يبنيه بنفسه من هذه القيم.
POSTGRES_USER="monitor"
POSTGRES_PASSWORD=""
POSTGRES_DB="monitoring"

# --- الجلسات ---------------------------------------------------------------
# 32 محرفاً فأكثر. ولّده بـ:  openssl rand -base64 48
# تغييره يُخرج كل المستخدمين من جلساتهم — لا تغيّره إلا عند اشتباه تسريب.
SESSION_SECRET=""

# مدة بقاء الجلسة بالأيام (1-90)
SESSION_TTL_DAYS="7"

# --- الطابور ---------------------------------------------------------------
# سقف ذاكرة Redis. 256mb يكفي لطابور هذه المنصة على خادم 2GB.
# ارفعه إلى 512mb على خادم 4GB فأكثر.
REDIS_MAXMEMORY="256mb"

# --- Apify -----------------------------------------------------------------
# رمز الوصول من console.apify.com ← Settings ← Integrations.
# يبقى هنا وحده: لا يُخزَّن في قاعدة البيانات ولا يظهر في الواجهة إطلاقاً.
APIFY_TOKEN=""
APIFY_API_BASE="https://api.apify.com/v2"

# سقف صلب لعدد العناصر في العملية الواحدة — حماية من استهلاك الحصة بالخطأ
APIFY_MAX_ITEMS_HARD_CAP="1000"

# مهلة عملية الاستخراج بالثواني قبل اعتبارها فاشلة
APIFY_RUN_TIMEOUT_SECONDS="900"

# --- حساب المالك الأول -----------------------------------------------------
# يُنشأ عند أول إقلاع فقط. إن كان الحساب موجوداً فلا يُلمس ولا تُغيَّر كلمته،
# فترك هذه القيم هنا بعد النشر الأول لا يعيد ضبط شيء.
# لتغيير كلمة المرور لاحقاً:
#   docker compose -f docker-compose.prod.yml exec app npm run owner:reset -- "كلمة_جديدة"
SEED_OWNER_EMAIL=""
SEED_OWNER_NAME=""
SEED_OWNER_PASSWORD=""

# --- ثابت ------------------------------------------------------------------
NODE_ENV="production"

# --- قاعدة بيانات مُدارة خارج الخادم (اختياري) -----------------------------
# هذا الملف يخدم مسار docker compose حيث القاعدة داخل الشبكة الخاصة بلا TLS.
# إن وصلت قاعدةً مُدارة بدل ذلك، ضع شهادة سلطتها هنا ليجري التحقق الكامل من
# هويتها. PEM كامل أو نصّه مُرمّزاً بـ base64.
# DATABASE_CA_CERT=""

# عدد مهام الاستخراج المتوازية في العامل. الافتراضي 2.
# WORKER_CONCURRENCY="2"
