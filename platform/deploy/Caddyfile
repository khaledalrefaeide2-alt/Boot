# =============================================================================
# الوكيل العكسي وشهادة HTTPS
#
# Caddy يطلب الشهادة من Let's Encrypt ويجدّدها وحده قبل انتهائها. لا يوجد
# certbot ولا cron ولا شهادة تنتهي يوم جمعة فيسقط الموقع.
#
# شرط عمل ذلك: النطاق في {$APP_DOMAIN} يشير فعلاً إلى IP هذا الخادم،
# والمنفذان 80 و443 مفتوحان. الشهادة تُطلب عند أول إقلاع، فإن كان النطاق
# غير مضبوط بعد فستفشل المحاولة وتتكرر — راجع السجل.
# =============================================================================
{
	email {$ACME_EMAIL}
	# سجلات بصيغة سطرية مقروءة بدل JSON — تُقرأ بالعين عند العطل
	log {
		format console
	}
}

{$APP_DOMAIN} {
	encode zstd gzip

	# HSTS يُضاف هنا لا في التطبيق: هو وعدٌ خاص بالمنفذ المشفَّر، ومن يملكه
	# هو من ينهي التشفير. التطبيق خلف الوكيل يتكلم HTTP ولا يعرف شيئاً عنه.
	# مدة سنة، وبلا preload لأن التراجع عنها لاحقاً مكلف.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# سقف لحجم الطلب: أكبر ما يرفعه المستخدم ملف استيراد حسابات محدود بـ500
	# صف. عشرون ميغابايت سقف سخيّ لذلك، ويمنع استنزاف قرص الخادم برفعٍ عابث.
	request_body {
		max_size 20MB
	}

	# مسار فحص الصحّة لا يُسجَّل: يُطلب كل عشر ثوانٍ، وتسجيله يغرق السجل
	# بأسطر لا تفيد ويخفي بينها الطلبات الحقيقية.
	@health path /api/health
	log_skip @health

	# ترويسات X-Forwarded-Proto و-Host و-For يضيفها Caddy وحده لكل طلب
	# مُمرَّر، فلا تُكتب هنا: تكرارها لا يضيف شيئاً وقد يُلبس على القارئ.
	reverse_proxy app:3000 {
		# تصدير تقرير كبير قد يتأخّر قبل أن يبدأ الردّ. المهلة على ترويسة
		# الاستجابة لا على الاتصال كله، فالتنزيل الطويل لا يُقطع.
		transport http {
			response_header_timeout 300s
		}
	}
}
