# =============================================================================
# ما يُستبعد من سياق بناء الصورة
# =============================================================================

# الأسرار — لا يجوز أن تدخل الصورة إطلاقاً، فهي تُمرَّر كمتغيرات بيئة عند التشغيل
.env
.env.*
!.env.example

# اعتماديات ومخرجات بناء خاصة بجهاز المطوّر — تُبنى داخل الصورة من جديد
node_modules
.next
out
build
dist
src/generated
*.tsbuildinfo
next-env.d.ts

# سجلات ونسخ احتياطية وملفات تصدير
*.log
npm-debug.log*
exports
backups/*.dump
backups/*.sql

# بيانات المستودع وأدوات التطوير
.git
.gitignore
.gitattributes
.vscode
.idea
.DS_Store
Thumbs.db

# ملفات لا تؤثر في التشغيل
README.md
AGENTS.md
CLAUDE.md

# سكربتات تهيئة تخص جهاز المستخدم لا الحاوية
setup.ps1
setup.bat
setup.sh

# ملاحظة: مجلد scripts يجب أن يبقى داخل الصورة.
# npm run start يشغّل scripts/next-with-port.mjs، كما أن استعادة كلمة مرور
# المالك تُنفَّذ داخل الحاوية عبر:  docker compose exec web npm run owner:reset

# وثائق وملفات نشر تُقرأ على الخادم لا داخل الصورة
DEPLOY.md
deploy
docker-compose*.yml
design-system

# مواصفات النشر ووثائقه — تُقرأ في لوحة المزوّد لا داخل الصورة
.do
DEPLOY-APP-PLATFORM.md
