{
  "name": "media-monitoring-platform",
  "version": "1.0.0",
  "private": true,
  "description": "منصة رصد وتحليل المنصات الإعلامية — نظام داخلي",
  "scripts": {
    "dev": "prisma generate && node scripts/next-with-port.mjs dev",
    "build": "prisma generate && next build",
    "start": "prisma generate && node scripts/next-with-port.mjs start",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "worker": "tsx --conditions=react-server src/worker/index.ts",
    "worker:dev": "tsx watch --conditions=react-server src/worker/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "setup:db": "prisma migrate deploy && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "verify:pipeline": "tsx --conditions=react-server scripts/verify-pipeline.ts",
    "verify:scope": "tsx --conditions=react-server scripts/verify-scope.ts",
    "owner:reset": "tsx --conditions=react-server scripts/reset-owner-password.ts",
    "media:repair": "tsx --conditions=react-server scripts/repair-media-urls.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-table": "9.2.4",
    "bcryptjs": "3.0.3",
    "bullmq": "6.3.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "^17.2.3",
    "exceljs": "4.4.0",
    "ioredis": "6.0.0",
    "jose": "6.2.10",
    "lucide-react": "1.40.0",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.4.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/bcryptjs": "3.0.0",
    "@types/node": "24.10.1",
    "@types/pg": "^8.15.6",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.4",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.11"
  }
}
