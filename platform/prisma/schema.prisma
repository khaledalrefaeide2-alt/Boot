// ---------------------------------------------------------------------------
// منصة رصد وتحليل المنصات الإعلامية — مخطط قاعدة البيانات
// ---------------------------------------------------------------------------

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

// ============================ التعدادات (Enums) ============================

/// أدوار النظام
enum Role {
  OWNER
  ADMIN
  SUPERVISOR
  VIEWER
}

/// حالة المستخدم
enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

/// حالة عامة للكيانات (منصة / حساب / كلمة مفتاحية ...)
enum EntityStatus {
  ACTIVE
  INACTIVE
}

/// نوع الحساب المرصود
enum AccountType {
  PAGE
  PROFILE
  GROUP
  CHANNEL
  OTHER
}

/// ملكية الحساب: نملكه أم يخص جهة أخرى
enum AccountOwnership {
  OWNED
  EXTERNAL
}

/// ظهور الحساب
enum AccountVisibility {
  PUBLIC
  PRIVATE
}

/// حالات عملية الاستخراج
enum ExtractionStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  NO_RESULTS
}

/// مصدر تشغيل عملية الاستخراج
enum ExtractionTrigger {
  MANUAL
  SCHEDULED
  WEBHOOK
}

/// نوع المنشور
enum PostType {
  TEXT
  IMAGE
  VIDEO
  REEL
  LINK
  ALBUM
  STORY
  OTHER
}

/// المشاعر
enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
  MIXED
  UNKNOWN
}

/// مصدر تحديد المشاعر أو التصنيف
enum AnalysisSource {
  RULES
  MANUAL
  AI
}

/// أنواع التنبيهات الداخلية
enum NotificationType {
  EXTRACTION_FAILED
  EXTRACTION_SUCCEEDED
  EXTRACTION_NO_RESULTS
  HIGH_ENGAGEMENT_POST
  NEGATIVE_SENTIMENT_SPIKE
  KEYWORD_HIT
  USER_PENDING_APPROVAL
  SYSTEM
}

/// شدة التنبيه
enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  ERROR
}

/// صيغة التصدير
enum ReportFormat {
  EXCEL
  PDF
}

/// حالة تشغيل التقرير
enum ReportStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

/// نطاق التقرير الزمني
enum ReportPeriod {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

// ============================ المستخدمون والجلسات ============================

/// نطاق وصول المستخدم إلى بيانات الحسابات المرصودة
enum AccountAccess {
  /// يرى بيانات كل الحسابات — الوضع الافتراضي
  ALL
  /// يرى بيانات الحسابات المُسندة إليه وحدها
  ASSIGNED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String?
  role         Role       @default(VIEWER)
  status       UserStatus @default(PENDING)

  jobTitle    String?
  phone       String?
  avatarUrl   String?
  /// صلاحيات دقيقة إضافية فوق الدور (مفاتيح منطقية)
  permissions Json?

  /// نطاق البيانات: كل الحسابات، أو الحسابات المُسندة وحدها
  accountAccess AccountAccess @default(ALL)

  lastLoginAt        DateTime?
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  mustChangePassword Boolean   @default(false)

  approvedAt   DateTime?
  approvedById String?
  disabledAt   DateTime?
  createdById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  approvedBy    User?  @relation("UserApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedUsers User[] @relation("UserApprovedBy")
  createdBy     User?  @relation("UserCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdUsers  User[] @relation("UserCreatedBy")

  sessions           Session[]
  oauthAccounts      OAuthAccount[]
  resetTokens        PasswordResetToken[]
  auditLogs          AuditLog[]
  notifications      Notification[]
  savedDashboards    SavedDashboard[]
  extractionRuns     ExtractionRun[]
  backfills          Backfill[]
  analysisRuns       AnalysisRun[]
  reportRuns         ReportRun[]
  reportTemplates    ReportTemplate[]
  reviewedPosts      Post[]               @relation("PostReviewedBy")
  createdAccounts    Account[]            @relation("AccountCreatedBy")
  accountAssignments UserAccount[]
  createdKeywords    Keyword[]            @relation("KeywordCreatedBy")
  updatedSettings    Setting[]            @relation("SettingUpdatedBy")

  assistantConversations AssistantConversation[]

  analysisCorrections AnalysisCorrection[]
  analysisGuidance    AnalysisGuidance[]

  @@index([status])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

/// جلسات مخزّنة في القاعدة — الرمز يُحفظ مجزأً (hash) ويُرسل في كوكي HTTP-only
model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  csrfSecret String
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  ipAddress  String?
  userAgent  String?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// جاهز لربط مزودي الدخول الخارجيين لاحقاً (Google OAuth)
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ============================ المنصات والحسابات ============================

model Platform {
  id        String       @id @default(cuid())
  /// رمز فريد: facebook | x | instagram
  code      String       @unique
  name      String
  /// اسم أيقونة أو رمز تعبيري للعرض
  icon      String?
  color     String?
  status    EntityStatus @default(ACTIVE)
  sortOrder Int          @default(0)

  /// Apify Actor الافتراضي لهذه المنصة
  defaultActorId    String?
  /// مدخلات افتراضية تُدمج مع مدخلات كل تشغيل
  defaultActorInput Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts       Account[]
  posts          Post[]
  extractionRuns ExtractionRun[]
  backfills      Backfill[]
  dailyStats     DailyPlatformStat[]

  @@index([status])
  @@map("platforms")
}

model Account {
  id         String  @id @default(cuid())
  platformId String
  name       String
  /// اسم المستخدم أو المعرّف القصير
  username   String?
  url        String
  /// المعرّف الخارجي من المنصة إن توفر
  externalId String?

  type       AccountType       @default(PAGE)
  ownership  AccountOwnership  @default(EXTERNAL)
  visibility AccountVisibility @default(PUBLIC)

  /// مجموعة التصنيف — اختيارية، فالحسابات القائمة لا تُجبر على مجموعة
  groupId String?

  language String?
  country  String?
  status   EntityStatus @default(ACTIVE)
  isActive Boolean      @default(true)

  /// مدة الاستخراج بالأيام (نافذة زمنية للمنشورات)
  extractionWindowDays      Int @default(30)
  /// تكرار الاستخراج بالدقائق (0 = يدوي فقط)
  extractionIntervalMinutes Int @default(0)
  /// أقصى عدد منشورات لكل تشغيل — سقف الفوترة على Apify
  maxItemsPerRun            Int @default(100)

  /// تجاوز الـ Actor الافتراضي للمنصة عند الحاجة
  actorIdOverride    String?
  actorInputOverride Json?

  followersCount Int?
  avatarUrl      String?
  notes          String?

  lastExtractedAt     DateTime?
  lastSuccessfulRunAt DateTime?
  nextRunAt           DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  platform      Platform           @relation(fields: [platformId], references: [id], onDelete: Restrict)
  group         AccountGroup?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdBy     User?              @relation("AccountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  posts         Post[]
  runs          ExtractionRun[]
  backfills     Backfill[]
  keywords      AccountKeyword[]
  assignedUsers UserAccount[]
  dailyStats    DailyAccountStat[]

  @@unique([platformId, url])
  @@index([platformId, isActive])
  @@index([status])
  @@index([nextRunAt])
  @@index([groupId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("accounts")
}

/// ============================ مجموعات الحسابات ============================
///
/// تصنيف تنظيمي للحسابات المرصودة يعلو المنصة ولا يتبعها: «النخبة» مجموعة
/// واحدة لها حسابات على فيسبوك وإكس وإنستغرام معاً، و«وزارات» مجموعة تضم
/// حسابات من منصات مختلفة أيضاً. فالمجموعة بُعدٌ مستقل عن المنصة لا فرعٌ
/// منها، ولذلك جدول لا حقل نصّي ولا تعداد:
///
///   • جدول — فالأسماء تُضاف وتُعاد تسميتها من الإدارة بلا ترحيل جديد.
///   • مرجع لا نصّ — فإعادة تسمية مجموعة لا تترك حسابات معلّقة على الاسم القديم.
///   • SetNull عند الحذف — حذف مجموعة لا يحذف حساباتها، وهي بيانات رصد
///     لا تُفقد بحذف تصنيف.
model AccountGroup {
  id          String       @id @default(cuid())
  /// معرّف ثابت لا يتغيّر بإعادة التسمية — تُبنى عليه الروابط والفلاتر
  code        String       @unique
  name        String
  description String?
  /// ترتيب الظهور في القوائم والفلاتر — الأصغر أولاً
  sortOrder   Int          @default(0)
  status      EntityStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]

  @@index([status, sortOrder])
  @@map("account_groups")
}

// ============================ عمليات الاستخراج ============================

model ExtractionRun {
  id         String  @id @default(cuid())
  accountId  String?
  platformId String?

  actorId        String
  apifyRunId     String?
  apifyDatasetId String?

  status  ExtractionStatus  @default(PENDING)
  trigger ExtractionTrigger @default(MANUAL)

  requestedById String?

  /// سقف الفوترة الممرَّر إلى Apify
  maxItems   Int?
  /// بداية النافذة الزمنية المطلوبة — يحددها المشغّل يدوياً في التشغيل اليدوي
  windowFrom DateTime?
  /// نهاية النافذة الزمنية المطلوبة
  windowTo   DateTime?
  /// المدخلات المرسلة إلى الـ Actor (بدون أي أسرار)
  input      Json?

  itemsFetched Int @default(0)

  /**
   * ما جُلب ثمّ سقط خارج النافذة الزمنية المطلوبة.
   * كان يُحسب في طبقة الاستيراد ثمّ يُهمَل، فيرى المشغّل «جُلب 855 · حُفظ 43»
   * بلا ما يفسّر الفارق: أهي منشورات مخزّنة سابقاً؟ أم خارج المدى؟ أم فشل
   * تحويل؟ وثلاثة احتمالات بعلاج مختلف لا يفرّق بينها رقمان.
   */
  itemsOutOfWindow Int @default(0)

  /// ردود استُبعدت — تُعدّ وتُعرض، فالاستبعاد الصامت يُقرأ نقصاً في البيانات
  itemsReplies Int @default(0)

  /**
   * أقدم وأحدث تاريخ في ما أعاده المزوّد — قبل أي فلترة.
   * هذان الحقلان يفصلان في سؤال لا يُجاب بغيرهما: هل احترم المشغّل النطاق
   * المطلوب؟ فإن كان المطلوب أسبوعاً وجاء ما يغطّي شهرين، فالمشغّل يتجاهل
   * حدود التاريخ ويُعيد آخر N عنصراً — وهذا يعني أن سقف العناصر قد ينفد
   * قبل بلوغ أوّل النطاق، فتضيع منشورات داخل المدى بلا أن يظهر لها أثر.
   * وبدونهما يبقى «798 خارج النافذة» رقماً لا يُعرف أهو سلوك سليم أم فقد.
   */
  fetchedFrom  DateTime?
  fetchedTo    DateTime?
  itemsSaved   Int       @default(0)
  itemsSkipped Int       @default(0)
  itemsFailed  Int       @default(0)

  errorMessage String?
  errorDetails Json?
  /// عينة خام محدودة من النتائج للمراجعة والتشخيص
  rawSample    Json?

  /**
   * المقطع الذي تنتمي إليه هذه التشغيلة من استخراج تاريخي.
   * تشغيلةٌ واحدة لا تغطّي سنوات، فالمدى الطويل يُقطَّع نوافذ متتابعة،
   * ولكلّ نافذة تشغيلة كاملة بسقفها ونتائجها وعدّاداتها.
   */
  backfillId  String?
  backfillSeq Int?

  queueJobId String?
  attempt    Int       @default(1)
  startedAt  DateTime?
  finishedAt DateTime?
  durationMs Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  account     Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform    Platform? @relation(fields: [platformId], references: [id], onDelete: SetNull)
  requestedBy User?     @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  backfill    Backfill? @relation(fields: [backfillId], references: [id], onDelete: SetNull)
  posts       Post[]

  @@index([status, createdAt])
  @@index([accountId, createdAt])
  @@index([platformId, createdAt])
  @@index([apifyRunId])
  @@index([backfillId, backfillSeq])
  @@map("extraction_runs")
}

/// حالة الاستخراج التاريخي
enum BackfillStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

/**
 * استخراج تاريخي — مدىً يمتدّ سنوات يُنفَّذ نافذةً بعد نافذة.
 * المقاطع لا تُنشأ كلها مقدَّماً بل واحداً إثر واحد: صفٌّ واحد معلّق لكل
 * حساب هو ما يفترضه قيد «لا تشغيل موازٍ»، وثمانون صفاً معلّقاً تُغرق سجلّ
 * العمليات وتجعل الإلغاء ثمانين إلغاءً. فالتقدّم يُحفظ هنا، والمقطع التالي
 * يُنشأ حين ينتهي الذي قبله.
 */
model Backfill {
  id         String @id @default(cuid())
  accountId  String
  platformId String

  /// المدى المطلوب كاملاً
  fromDate DateTime
  toDate   DateTime

  /// طول النافذة الواحدة بالأيام
  chunkDays        Int
  /// سقف العناصر لكل نافذة — سقف الفوترة مضروبٌ في عدد المقاطع
  maxItemsPerChunk Int

  totalChunks  Int
  doneChunks   Int @default(0)
  /// مقاطع انتهت بالفشل — لا توقف البقية ما لم تتتابع
  failedChunks Int @default(0)

  status BackfillStatus @default(RUNNING)

  /// حصيلة ما حُفظ فعلاً من كل المقاطع
  itemsSaved   Int @default(0)
  itemsFetched Int @default(0)

  /// سبب التوقّف حين يتوقّف قبل إتمام المدى
  stopReason String?

  requestedById String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?

  account     Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform    Platform        @relation(fields: [platformId], references: [id], onDelete: Cascade)
  requestedBy User?           @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  runs        ExtractionRun[]

  @@index([accountId, createdAt])
  @@index([status, createdAt])
  @@map("backfills")
}

// ============================ المنشورات ============================

model Post {
  id         String @id @default(cuid())
  accountId  String
  platformId String

  /// المعرّف الخارجي للمنشور إن توفر
  externalId String?
  /// مفتاح منع التكرار: المعرّف الخارجي أو بصمة الرابط
  dedupeKey  String

  url  String?
  text String?

  publishedAt DateTime?
  postType    PostType  @default(OTHER)
  language    String?
  country     String?
  location    String?

  authorName   String?
  imageUrl     String?
  videoUrl     String?
  thumbnailUrl String?
  /// روابط وسائط إضافية — روابط فقط، لا ملفات
  mediaUrls    Json?

  likes           Int @default(0)
  comments        Int @default(0)
  shares          Int @default(0)
  views           Int @default(0)
  saves           Int @default(0)
  /// مجموع التفاعل المخزَّن مسبقاً لتسريع الفرز والتجميع
  engagementTotal Int @default(0)

  sentiment       Sentiment       @default(UNKNOWN)
  sentimentScore  Float?
  sentimentSource AnalysisSource?

  topicId     String?
  topicSource AnalysisSource?

  /// كلمات مفتاحية مكتشفة (نسخة مسطحة للبحث السريع)
  detectedKeywords String[] @default([])
  hashtags         String[] @default([])

  /**
   * مفتاح المصغّرة المحفوظة عندنا.
   * روابط صور فيسبوك موقّعة وتنتهي صلاحيتها بعد ساعات إلى أيام (oh/oe في
   * الرابط)، فالمنشور القديم يفقد صورته وإن بقي رابطها مخزّناً. فتُجلب
   * الصورة عند الاستيراد وتُحفظ مصغّرةً، ويبقى هذا مفتاحها.
   * والمفتاح بصمةُ الرابط لا معرّفُ المنشور: الصورة الواحدة تُشارَك بين
   * منشورات عدّة، فتُحفظ مرة.
   */
  mediaKey String?

  /// البيانات الخام من Apify للرجوع إليها عند الحاجة
  rawData Json?

  extractionRunId String?

  /// إخفاء من العرض بعد المراجعة بدل الحذف النهائي
  isHidden     Boolean   @default(false)
  reviewedAt   DateTime?
  reviewedById String?
  reviewNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform      Platform       @relation(fields: [platformId], references: [id], onDelete: Cascade)
  topic         Topic?         @relation(fields: [topicId], references: [id], onDelete: SetNull)
  extractionRun ExtractionRun? @relation(fields: [extractionRunId], references: [id], onDelete: SetNull)
  reviewedBy    User?          @relation("PostReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  keywordLinks  PostKeyword[]
  hashtagLinks  PostHashtag[]

  embeddings PostEmbedding[]

  analysis PostAnalysis?

  corrections AnalysisCorrection[]

  @@unique([accountId, dedupeKey])
  @@index([publishedAt(sort: Desc)])
  @@index([accountId, publishedAt(sort: Desc)])
  @@index([platformId, publishedAt(sort: Desc)])
  @@index([engagementTotal(sort: Desc)])
  @@index([sentiment, publishedAt(sort: Desc)])
  @@index([postType])
  @@index([language])
  @@index([country])
  @@index([topicId])
  @@index([isHidden, publishedAt(sort: Desc)])
  @@index([extractionRunId])
  @@index([mediaKey])
  @@index([text(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([hashtags], type: Gin)
  @@index([detectedKeywords], type: Gin)
  @@map("posts")
}

// ============================ الكلمات والهاشتاغات والتصنيفات ============================

model Keyword {
  id             String       @id @default(cuid())
  term           String       @unique
  /// صيغة مطبّعة للمطابقة (بدون تشكيل وبألف موحدة)
  normalizedTerm String
  category       String?
  color          String?
  weight         Int          @default(1)
  status         EntityStatus @default(ACTIVE)
  /// كلمة حساسة تُطلق تنبيهاً عند ظهورها
  isAlerting     Boolean      @default(false)
  matchCount     Int          @default(0)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User?            @relation("KeywordCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  posts     PostKeyword[]
  accounts  AccountKeyword[]

  @@index([status])
  @@index([normalizedTerm])
  @@map("keywords")
}

/// إسناد حساب مرصود إلى مستخدم — يُقرأ فقط حين يكون نطاقه ASSIGNED
model UserAccount {
  userId    String
  accountId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([userId, accountId])
  @@index([userId])
  @@index([accountId])
  @@map("user_accounts")
}

model AccountKeyword {
  accountId String
  keywordId String
  createdAt DateTime @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  keyword Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@id([accountId, keywordId])
  @@index([keywordId])
  @@map("account_keywords")
}

model PostKeyword {
  postId    String
  keywordId String
  createdAt DateTime @default(now())

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  keyword Keyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@id([postId, keywordId])
  @@index([keywordId])
  @@map("post_keywords")
}

