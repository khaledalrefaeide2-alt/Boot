// ═══════════════════════ المساعد الذكي ═══════════════════════

enum AssistantRole {
  USER
  ASSISTANT
}

/// محادثة بين مستخدم والمساعد. مملوكة لمستخدم واحد لا تُشارك.
model AssistantConversation {
  id     String @id @default(cuid())
  userId String

  /// يُشتقّ من أول سؤال إن لم يسمّها المستخدم
  title String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AssistantMessage[]

  @@index([userId, updatedAt])
  @@map("assistant_conversations")
}

/// رسالة واحدة داخل محادثة.
model AssistantMessage {
  id             String        @id @default(cuid())
  conversationId String
  role           AssistantRole
  content        String

  /// ما استُند إليه في الجواب: المنشورات المسترجَعة، والنموذج، والاستهلاك.
  /// يُحفظ للتدقيق لا للعرض — فبه وحده يمكن تفسير جواب قديم بعد تغيّر البيانات.
  metadata Json?

  createdAt DateTime @default(now())

  conversation AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("assistant_messages")
}

/// متّجه دلالي لمقطع من نصّ منشور.
///
/// الصورة المستعملة في هذا المشروع `postgres:16-alpine` ولا تحمل امتداد
/// pgvector، فالمتّجه يُخزَّن كمصفوفة أعداد عشرية ويُقاس التشابه بجيب
/// التمام في SQL على مجموعة مرشّحين مسبقة التصفية. والمتّجهات تُخزَّن
/// مُوحّدة الطول (L2) فيصير جيب التمام ضربَ نقطةٍ بحتاً بلا قسمة.
///
/// `model` و`dims` ليسا زينة: تغيير نموذج التوليد يغيّر البُعد والمعنى
/// معاً، ومقارنة متّجه من نموذج بمتّجه من آخر تعطي رقماً بلا دلالة. فبهما
/// يعرف السكربت ما يجب إعادة توليده وما يُترك.
model PostEmbedding {
  id         String @id @default(cuid())
  postId     String
  chunkIndex Int    @default(0)
  chunkText  String

  embedding Float[]
  model     String
  dims      Int

  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, chunkIndex])
  @@index([model])
  @@map("post_embeddings")
}

// ═══════════════════ التحليل بالذكاء الاصطناعي ═══════════════════

/// موقف المنشور من سياسات الدولة — بُعدٌ مستقل عن المشاعر.
///
/// الفصل بينهما مقصود: منشورٌ غاضب النبرة قد يكون مؤيّداً (غضبٌ على
/// معرقلي مشروع)، ومنشورٌ هادئ قد يكون معارضاً. وخلطُهما في حقل واحد
/// يُنتج رقماً لا يقرأ أيّاً منهما.
enum PostStance {
  SUPPORTIVE
  OPPOSED
  NEUTRAL
  MIXED
  UNCLEAR
}

/// إشارات محتوى ضارّ.
///
/// وهي وصفٌ لما في النصّ لا حكمٌ قانوني عليه. الفرق جوهري: «فيه لفظ
/// طائفي» ملاحظةٌ يراجعها إنسان، و«هذا جريمة» حكمٌ لا يصحّ أن يصدر عن
/// نموذج احتمالي عن شخص مُسمّى. فما يُرفع هنا يذهب إلى طابور المراجعة
/// ليقرّر فيه مختصّ.
enum RiskFlag {
  INCITEMENT_VIOLENCE
  SECTARIAN_REGIONAL
  HATE_SPEECH
  THREAT
  PLATFORM_POLICY
}

enum RiskSeverity {
  NONE
  LOW
  MEDIUM
  HIGH
}

/// نتيجة تحليل منشور واحد بالذكاء الاصطناعي.
///
/// تُحفظ في جدول مستقل لا في أعمدة على Post: التحليل يُعاد عند تغيير
/// النموذج أو الدليل، والاحتفاظ به منفصلاً يُبقي بيانات المنشور الأصلية
/// سليمة ويسمح بمعرفة «متى حُلِّل وبأيّ نموذج» بلا تلويث الصفّ الأصلي.
model PostAnalysis {
  id     String @id @default(cuid())
  postId String @unique

  stance     PostStance
  sentiment  Sentiment
  /// ثقة النموذج بنفسه من 0 إلى 1 — تُعرض ولا تُخفى
  confidence Float

  /// تعليل مختصر بالعربية يشرح سبب التصنيف، فيُراجَع الحكم لا يُقبل وحده
  rationale String

  /// الجهة المستهدفة — مؤسسة أو مسؤول أو خدمة، كما وردت في النصّ
  target String?

  /// الموضوع في كلمات قليلة
  subject String?

  /**
   * الدليل — مقتطف حرفيّ من المنشور يحمل التصنيف.
   * يُطابَق بنصّ المنشور قبل الحفظ، وما لا يطابق لا يُكتب: مراجعٌ يقرأ
   * اقتباساً بين قوسين يصدّقه، فالمقتطف المختلَق ضررٌ صافٍ لا فائدة ناقصة.
   */
  evidence String?

  /// جمع بين مدح ونقد — والتصنيف العام سلبيّ وفق السياسة
  isMixed Boolean @default(false)

  /// ينقل نقد غيره بلا تبنٍّ ولا ردّ — والتصنيف العام محايد
  isRelayedCriticism Boolean @default(false)

  /// سبب الحاجة إلى المراجعة البشرية، إن وُجد
  reviewReason String?

  /// الموضوعات المكتشفة في النصّ
  themes String[] @default([])

  riskFlags    RiskFlag[]   @default([])
  riskSeverity RiskSeverity @default(NONE)

  /**
   * هل يحتاج مراجعة بشرية؟
   * يُرفع تلقائياً عند ثقة منخفضة أو إشارة خطر. والقاعدة التي لا تُكسر:
   * لا يُتَّخذ إجراء على منشور بناءً على هذا التحليل وحده.
   */
  needsReview Boolean @default(false)

  model     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([stance])
  @@index([riskSeverity])
  @@index([needsReview])
  @@index([isMixed])
  @@map("post_analyses")
}

// ═══════════════ جولات التحليل ═══════════════

/// حالة جولة التحليل
enum AnalysisRunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

/**
 * جولة تحليل بالذكاء الاصطناعي.
 * التحليل كان يُشغَّل من سطر الأوامر وحده، فلا يملكه إلا من يملك الخادم.
 * وهو عملٌ يمتدّ دقائق على آلاف المنشورات، فلا يصلح أن يُنتظر في طلب
 * HTTP — ولا أن يُشغَّل بلا أثر يقول كم أُنجز وكم تعثّر.
 */
model AnalysisRun {
  id     String            @id @default(cuid())
  status AnalysisRunStatus @default(PENDING)

  /// الفلاتر التي حُدّدت للجولة — تُعرض ليُعرف ما شملته
  filters   Json?
  /// هل تُعاد المحلَّلة سابقاً أم تُتخطّى؟
  reanalyze Boolean @default(false)

  total    Int @default(0)
  done     Int @default(0)
  failed   Int @default(0)
  /// منشورات صُنّفت سلبيةً وفق السياسة — منها يُحسب إنذار ارتفاع السلبية
  negative Int @default(0)

  /// منشورات رُفعت للمراجعة لانخفاض ثقة النموذج
  review  Int @default(0)
  /// منشورات حملت إشارة خطر
  flagged Int @default(0)

  errorMessage String?

  requestedById String?
  queueJobId    String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  startedAt  DateTime?
  finishedAt DateTime?

  requestedBy User? @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("analysis_runs")
}

// ═══════════════ تعلّم التحليل من المراجعين ═══════════════

/// نطاق التوجيه — يُحقن في القسم المناسب من الدليل لا في أوّله
enum GuidanceScope {
  STANCE
  SENTIMENT
  RISK
  GENERAL
}

/// من أين جاء التوجيه
enum GuidanceSource {
  MANUAL
  ASSISTANT
}

/// تصحيح مراجع بشريّ على تحليل آلي.
///
/// هذا هو وقود التعلّم. ولا يُدرَّب به نموذج: يُسترجَع أقربُه إلى المنشور
/// الجديد دلالياً ويُعرض على النموذج مثالاً. والفرق عمليّ لا نظري —
/// التدريب يحتاج آلاف الأمثلة وساعات وصندوقاً أسود، وهذا يعمل من أول
/// تصحيح، ويُعرف فيه بالضبط أيّ مثال أثّر في أيّ حكم، ويُلغى أثره بحذفه.
model AnalysisCorrection {
  id     String @id @default(cuid())
  postId String

  /**
   * مقتطف النصّ يُنسخ ولا يُقرأ من المنشور عند الحاجة.
   * المنشور قد يُحذف أو يُعدّل، والمثال التعليمي يجب أن يبقى كما كان
   * لحظة تصحيحه — وإلا صار المثال يعلّم شيئاً والتصحيح يقول غيره.
   */
  excerpt String

  /// ما قاله النموذج — يُحفظ ليُقاس الانحراف لا للعرض وحده
  aiStance    PostStance?
  aiSentiment Sentiment?
  aiRiskFlags RiskFlag[]  @default([])

  /// ما صحّحه المراجع
  stance    PostStance?
  sentiment Sentiment?
  riskFlags RiskFlag[]  @default([])

  /// تعليل المراجع — أنفع حقل في الجدول: المثال يقول «ماذا»، وهذا «لماذا»
  note String?

  embedding Float[]
  model     String
  dims      Int

  correctedById String
  createdAt     DateTime @default(now())

  post        Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  correctedBy User @relation(fields: [correctedById], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([createdAt])
  @@map("analysis_corrections")
}

/// توجيه عام يكتبه المدير ويدخل كلّ تحليل بعده.
///
/// التصحيح يعلّم بالمثال، وهذا يعلّم بالقاعدة. والاثنان لازمان: «هذا
/// المنشور ليس تحريضاً» مثالٌ لا يُعمَّم وحده، و«اعتبر المطالبة بالخدمات
/// نقداً لا معارضة» قاعدةٌ تسري على ما لم يقع بعد.
model AnalysisGuidance {
  id          String        @id @default(cuid())
  scope       GuidanceScope @default(GENERAL)
  instruction String

  /**
   * مصدر التوجيه.
   * ما يلتقطه المساعد من كلام المستخدم يُحفظ غير مفعّل: التوجيه يُغيّر
   * تصنيف كل منشور قادم، وجملةٌ قيلت في سياق سؤال قد تُقرأ أمراً دائماً
   * وهي ليست كذلك. فيُحفظ ويُعرض ويُفعَّل بقرار.
   */
  source        GuidanceSource @default(MANUAL)
  /// نصّ المستخدم كما كتبه — ليُراجَع ما استُخلص منه
  sourceMessage String?

  isActive  Boolean @default(false)
  sortOrder Int     @default(0)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([isActive, sortOrder])
  @@map("analysis_guidance")
}
