# ---------------------------------------------------------------------------
# Peace Emergency Digital Information Platform — environment configuration
# Copy to `.env` and fill in. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
APP_ENV=development                 # development | staging | production
DEBUG=true
# 32+ random bytes. Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-long-random-value
# Salt used to hash citizen IP addresses before storage (privacy). Rotate carefully:
# rotating invalidates the ability to correlate historical abuse reports.
IP_HASH_SALT=change-me-too

# --- Database ---------------------------------------------------------------
# SQLite (default, zero-setup, for local development and the demo):
DATABASE_URL=sqlite:///./peace_platform.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg://peace:password@localhost:5432/peace_platform

# --- Server -----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Comma-separated origins allowed to call the JSON API from a browser.
CORS_ORIGINS=

# --- Security ---------------------------------------------------------------
SESSION_IDLE_MINUTES=60             # inactivity timeout
SESSION_ABSOLUTE_HOURS=12           # hard cap regardless of activity
COOKIE_SECURE=false                 # MUST be true in production (HTTPS only)
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_ENABLED=true

# --- AI / RAG ---------------------------------------------------------------
# Leave ANTHROPIC_API_KEY empty to run fully offline: the platform then uses the
# deterministic extractive provider, which never invents text. See docs/AI_RAG.md.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=medium                   # low | medium | high | xhigh | max
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60

# Embeddings. `hashing` is the offline default and requires no network.
# `voyage` uses Voyage AI (Anthropic's recommended embedding partner).
EMBEDDING_PROVIDER=hashing          # hashing | voyage
EMBEDDING_DIM=512
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# --- Uploads ----------------------------------------------------------------
UPLOAD_DIR=./var/uploads
MAX_UPLOAD_MB=25

# --- Demo -------------------------------------------------------------------
# When true the seeded demonstration dataset is loaded and DEMO banners are shown.
DEMO_MODE=true
