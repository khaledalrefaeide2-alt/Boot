{
  "appId": "com.digitalmedia.moderation",
  "appName": "الإعلام الرقمي",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "backgroundColor": "#0b1220",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    }
  }
}
